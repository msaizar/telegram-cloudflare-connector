# Local Development Environment Variables
# Copy this file to .env.local and fill in your values

# Telegram API Credentials
# Get these from https://my.telegram.org/apps
TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here

# Telegram Session String
# Generate this using: docker-compose run --rm scripts ./scripts/generate_session_str.py
TELEGRAM_SESSION_STR=your_session_string_here

# Rate Limiting Configuration (optional)
MAX_CHANNELS_PER_RUN=15
API_CALL_DELAY=1.5
MAX_FLOOD_WAIT=300

# Database Configuration (optional)
DB_CONNECT_TIMEOUT=10
DB_STATEMENT_TIMEOUT=30000

# Note: TIMESCALE_CONNECTION is set automatically by docker-compose.yml
# to point to the local TimescaleDB container
